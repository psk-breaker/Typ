<Window x:Class="Writing_App.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Item"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        MinWidth="360">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="Rename item:" Margin="0,0,0,8" FontWeight="SemiBold"/>
        <TextBox x:Name="InputBox" MinWidth="300" Height="28" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="90" Click="OK_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
